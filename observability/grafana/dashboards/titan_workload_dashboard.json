  "panels": [
    {
      "title": "HTTP Traffic Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(titan_http_requests_total[1m])) by (status_code)",
          "legendFormat": "Status {{status_code}}"
        }
      ]
    },
    {
      "title": "HTTP 5xx Error Surge (Incidents)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(titan_http_requests_total{status_code=~\"5..\"}[1m]))",
          "legendFormat": "5xx Errors/sec"
        }
      ]
    },
    {
      "title": "P99 Request Latency (Seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(titan_http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "P99 Latency"
        }
      ]
    },
    {
      "title": "Inventory Catalog Total Items",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "titan_inventory_items_total",
          "legendFormat": "Total Items"
        }
      ]
    },
    {
      "title": "Reliability Lab Active Faults",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "targets": [
        {
          "expr": "sum(titan_simulated_faults_total)",
          "legendFormat": "Simulated Faults"
        }
      ]
    }
