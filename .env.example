# ==============================================================================
# TITAN PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT COMMIT .env WITH PRODUCTION SECRETS OR SENSITIVE CREDENTIALS.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Runtime Mode
# ------------------------------------------------------------------------------
TITAN_ENV=development
LOG_LEVEL=INFO
DEBUG=false

# ------------------------------------------------------------------------------
# 2. Managed Workload: Inventory API
# ------------------------------------------------------------------------------
INVENTORY_API_HOST=0.0.0.0
INVENTORY_API_PORT=8001
# PostgreSQL Connection (local docker compose or remote RDS)
DATABASE_URL=postgresql+psycopg2://titan_user:titan_secure_pass@localhost:5432/titan_inventory
# Test/fallback SQLite database (used during local unit tests)
TEST_DATABASE_URL=sqlite:///./test_inventory.db

# ------------------------------------------------------------------------------
# 3. Reliability Lab & Fault Injection Safety Controls
# ------------------------------------------------------------------------------
# MUST be explicitly set to 'true' to mount and allow fault injection endpoints.
# In staging/production this should default to 'false'.
ENABLE_FAULT_INJECTION=true
FAULT_INJECTION_AUTH_TOKEN=dev-reliability-test-key-32ch

# ------------------------------------------------------------------------------
# 4. TITAN Platform API
# ------------------------------------------------------------------------------
PLATFORM_API_HOST=0.0.0.0
PLATFORM_API_PORT=8000
PLATFORM_DATABASE_URL=sqlite:///./titan_platform.db
JWT_SECRET_KEY=dev-insecure-change-in-production-jwt-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# 5. TITAN Incident Engine
# ------------------------------------------------------------------------------
INCIDENT_ENGINE_PORT=8002
ALERTMANAGER_WEBHOOK_SECRET=dev-alertmanager-webhook-secret
DIAGNOSIS_MODE=remediation  # 'diagnosis_only' or 'remediation'

# ------------------------------------------------------------------------------
# 6. Observability & Integrations (Optional Local Simulation)
# ------------------------------------------------------------------------------
PROMETHEUS_URL=http://localhost:9090
ALERTMANAGER_URL=http://localhost:9093
GRAFANA_URL=http://localhost:3000

# Optional ELK / Splunk / Vault (Default to disabled locally)
ENABLE_ELK_LOGGING=false
ENABLE_SPLUNK_ADAPTER=false
SPLUNK_HEC_URL=http://localhost:8088/services/collector
SPLUNK_HEC_TOKEN=
ENABLE_VAULT_INTEGRATION=false
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=
